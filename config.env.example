# =========================================================================
# Cloud Armor demo — configuration.
#
# Copy this to config.env, set PROJECT_ID, and run ./provision-all.sh.
# Everything else has a working default.
#
#     cp config.env.example config.env
#
# config.env is gitignored. Keep it that way: it names your project and
# will contain your own IP ranges.
#
# This file is `source`d by lib.sh, which means it is executed as bash.
# That is why every line is `export NAME="value"` — `export` makes the
# variable visible to the gcloud and kubectl processes the scripts run.
# =========================================================================

# ---- Required -----------------------------------------------------------
export PROJECT_ID="your-gcp-project-id"

# ---- Region -------------------------------------------------------------
# Everything regional lives here: GKE, the internal load balancer, the PSC
# attachment and the PSC NEG. They must all share a region — a service
# attachment can only publish a load balancer in its own region.
#
# The EDGE load balancer is global and has no region. That is the point of
# it: one anycast IP served from Google edge locations worldwide.
export REGION="europe-west1"

# ---- Naming -------------------------------------------------------------
# Every resource name is derived from this prefix in lib.sh. Change it and
# the entire demo is renamed, which lets two copies coexist in one project.
export PREFIX="armor"

# ---- Networks -----------------------------------------------------------
# Two VPCs, joined only by Private Service Connect.
#
#   consumer  holds the PSC NEG the edge load balancer uses
#   producer  holds GKE, the internal load balancer and the attachment
#
# Because PSC does not exchange routes, these ranges would be allowed to
# overlap. They are kept distinct here purely so log output is easier to
# read — you can tell at a glance which side an address belongs to.
export CONSUMER_VPC="${PREFIX}-consumer-vpc"
export PRODUCER_VPC="${PREFIX}-producer-vpc"

# CIDR notation: /24 is 256 addresses, /20 is 4096, /16 is 65536. Four
# addresses in every subnet are reserved and unusable.
export CONSUMER_SUBNET_RANGE="10.60.0.0/24"  # hosts the PSC NEG's /32

# GKE needs three ranges: one for nodes, one for pods, one for Services.
# Pods get by far the largest because every pod gets its own IP — the
# usual cause of "cluster cannot scale" is a pod range sized too small,
# and it cannot be changed after the cluster is created.
export GKE_SUBNET_RANGE="10.10.0.0/20"       # nodes
export GKE_PODS_RANGE="10.20.0.0/16"         # pods (secondary range)
export GKE_SVCS_RANGE="10.30.0.0/20"         # Services (secondary range)

# Two special-purpose subnets. Neither can hold VMs or forwarding rules;
# Google Cloud reserves them for its own managed infrastructure.
#
#   proxy    addresses for the managed Envoy proxies that implement the
#            internal load balancer. Required, one per region per VPC.
#            /23 is the recommended size; /26 is the minimum.
#   psc nat  addresses consumer traffic is source-NAT'd onto when crossing
#            the PSC boundary. One address per connected consumer.
export PROXY_SUBNET_RANGE="10.40.0.0/23"     # purpose REGIONAL_MANAGED_PROXY
export PSC_NAT_SUBNET_RANGE="10.50.0.0/24"   # purpose PRIVATE_SERVICE_CONNECT

# ---- GKE ----------------------------------------------------------------
export CLUSTER_NAME="${PREFIX}-demo"
export APP_NAMESPACE="armor-demo"
export APP_NAME="hello-world"

# A stock Google sample that answers with JSON describing itself and the
# request headers it received. That echo is why it was chosen: with the
# WAF off you can watch an attack payload arrive at the pod. It has no
# database and nothing to inject into — it is not vulnerable, just honest
# about what reached it.
export APP_IMAGE="us-docker.pkg.dev/google-samples/containers/gke/whereami:v1"
export APP_PORT="8080"

# ---- Cloud Armor --------------------------------------------------------
# Two policies, at two enforcement points.
#
#   EDGE_POLICY (global)   attached to the edge load balancer with gcloud.
#                          IP denylist/allowlist, geo, AND the WAF.
#
#   APP_POLICY (regional)  attached to the GKE internal load balancer via
#                          a GCPBackendPolicy manifest. Rate limiting only.
#
# Why the WAF is not on the app policy: a regional INTERNAL Application
# Load Balancer cannot enforce WAF rules, managed rules, body filtering,
# geography or ASN. Add them anyway and they attach without error, report
# healthy, and never fire. armor.sh refuses to let you do it. See README.
export EDGE_POLICY="${PREFIX}-edge"
export APP_POLICY="${PREFIX}-app"

# OWASP Core Rule Set version behind the preconfigured WAF rules. Current
# is v422 (CRS 4.22); older tutorials still show v33, which is why this is
# pinned rather than assumed. `armor.sh create` verifies it exists and
# lists the alternatives if not.
export WAF_RULESET_VERSION="v422"

# How many signatures are active, 0 to 4. Higher catches more attacks and
# produces more false positives. 1 is the conservative starting point and
# still blocks every payload in attack.sh. Tune a single noisy signature
# out by ID rather than lowering this for the whole rule set.
export WAF_SENSITIVITY="1"

# ---- Demo parameters ----------------------------------------------------
# CIDRs the denylist rule blocks. These defaults are RFC 5737
# documentation ranges — reserved for examples and never routed on the
# real internet — so the rule exists and is visible without blocking
# anybody. For a live demonstration use `./armor.sh deny-me`, which adds
# your own address.
export DENY_CIDRS="198.51.100.0/24,203.0.113.0/24"

# CIDRs allowed when `armor.sh allowlist on` flips the default rule to
# deny. Your own public IP is added automatically, so you cannot lock
# yourself out of your own load balancer.
export ALLOW_CIDRS=""

# Country to block, as a Unicode CLDR region code (SE, US, DE...). Leave
# empty and armor.sh uses your own detected country, so the block is
# demonstrable live against yourself.
export GEO_CC=""

# ---- Geo probe VM (used by ./attack.sh geo) -----------------------------
# Geo blocking can only be validated with traffic from a second country.
# This is a throwaway e2-micro in a US region, in its own VPC, standing in
# for "a client somewhere else on the internet". It is NOT part of the
# protected architecture — it is a test client that happens to live in GCP.
#
# Created by ./05-geo-probe.sh, which is optional. Everything else works
# without it; only `./attack.sh geo` needs it.
#
# Cost is roughly a cent an hour, and ./teardown.sh removes it.
export PROBE_REGION="us-central1"
export PROBE_ZONE="us-central1-a"
export PROBE_VPC="${PREFIX}-probe-vpc"
export PROBE_SUBNET_RANGE="10.80.0.0/24"
export PROBE_VM="${PREFIX}-geo-probe"
export PROBE_MACHINE="e2-micro"

# ---- Rate limiting (enforced by APP_POLICY, at the internal LB) ----------
# Throttle: over the limit, requests get 429 until the client slows down.
export RATE_LIMIT_COUNT="20"           # requests...
export RATE_LIMIT_INTERVAL="60"        # ...per this many seconds

# Rate-based ban: harsher. Cross the threshold on this path and you are
# blocked for BAN_DURATION even after you stop sending traffic. The usual
# shape for a login endpoint facing credential stuffing.
export BAN_PATH="/login"
export BAN_COUNT="10"
export BAN_INTERVAL="60"
export BAN_DURATION="120"              # seconds a client stays banned
